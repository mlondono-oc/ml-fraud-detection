{
  "data": {
    "path": "data/dataset.csv",
    "val_weeks": 1,
    "test_weeks": 2
  },
  "features": {
    "umbral_otros": 20
  },
  "training": {
    "n_iter": 30,
    "random_state": 42,
    "search_space": {
      "n_estimators": [200, 400, 800],
      "learning_rate": [0.02, 0.05, 0.1],
      "num_leaves": [15, 31, 63],
      "min_child_samples": [20, 50, 100],
      "colsample_bytree": [0.7, 0.85, 1.0],
      "reg_lambda": [0, 1, 5],
      "class_weight": [null, "balanced"]
    }
  },
  "business-rules": {
    "margin": 0.25,
    "fraud_loss": 1.0
  },
"inference": {
  "artifacts": "models/modelo.pkl",
  "tuning_results": "models/tuning.csv",
  "val_predictions": "models/predicciones_val.csv",
  "val_metrics": "models/metricas_val.json",
  "predictions": "models/predicciones.csv"
}

}
